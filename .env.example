# Copy this file to .env and fill in real values. Never commit .env.

# --- API / server ---
NEUROSCREEN_ENV=development
NEUROSCREEN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
NEUROSCREEN_DATABASE_URL=sqlite:///./data/neuroscreen.db

# --- LLM (Ollama) ---
NEUROSCREEN_OLLAMA_MODEL=gemma2:2b
NEUROSCREEN_OLLAMA_HOST=http://localhost:11434
